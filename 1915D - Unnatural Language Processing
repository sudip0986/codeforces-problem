#include <bits/stdc++.h>
using namespace std;

int main()
{
    int cc;
    cin>>cc;
    while(cc--)
    {
        int n;
        cin>>n;
        string s;
        cin>>s;
        string result;
        result.push_back(s[0]);
        for(int i=1; i<n; i++)
        {
            if(s[i]!='a' && s[i]!='e')
            {
                 if (  (s[i + 1] != 'a' && s[i + 1] != 'e'))
                    continue;

                else
                result.push_back(s[i]);
            }

            else
            {
                if( (s[i-1]!='a' && s[i-1]!='e') && ( (i + 1 < n) && s[i+1]!='a' && s[i+1]!='e')  )
                {
                    if (  s[i+2]!='a' && s[i+2]!='e')
                   { result.push_back(s[i]);
                    result.push_back(s[i+1]);
                    result.push_back('.');}
                    
                    else
                {
                    result.push_back(s[i]);
                    result.push_back('.');
                }
                }
                   else
                {
                    result.push_back(s[i]);
                    result.push_back('.');
                }
                
            }
        }
        if(result[result.size()-1]=='.')
        result.pop_back();

        cout<<result<<endl;
    }
}
