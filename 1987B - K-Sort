#include <bits/stdc++.h>
using namespace std;

int main()
{
    ios::sync_with_stdio(0);
    cin.tie(0);
    
    int cc;
    cin >> cc;
    while (cc--)
    {
        int n;
        cin >> n;
        vector<int> a(n);
        for (int i = 0; i < n; i++)
            cin >> a[i];

        long long k = 0;
        long long max_one = 0;

        for (int j = 1; j < n; j++)
        {
            if (a[j] < a[j - 1])
            {
                k += a[j - 1] - a[j];
                max_one = max(max_one, (long long)(a[j - 1] - a[j]));
                a[j] = a[j - 1];
            }
        }

        cout << k + max_one << "\n";
    }

    return 0;
}
