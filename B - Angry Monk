#include <bits/stdc++.h>
using namespace std;

// sudip code 

int main()
{
    int cc;
    cin >> cc;
    while (cc--)
    {
        int nn, k;
        cin >> nn >> k;
        vector<int> arr(k);
        for (int i = 0; i < k; i++)
            cin >> arr[i];

            //sort the code reversely
        sort(arr.begin(), arr.end());

        int steps = 0;

       for(int i=0;i<k-1;i++)
       {
        steps+=( arr[i]+(arr[i]-1) );
       }

        cout << steps << "\n";
    }
    return 0;
}
