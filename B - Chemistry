#include <bits/stdc++.h>
using namespace std;

int main()
{
    int cc;
    cin>>cc;
    while(cc--)
    {
        int n,k;
        cin>>n>>k;
        string s;
        cin>> s;
        vector<int>ch(26,0);

        for(int i=0; i<n; i++)
        {
            ch[s[i] - 'a']++;
        }
        
        for(int i=0; i<26; i++)
        {
             if(k==0)
                break;
            if(ch[i]%2!=0)
            {
                ch[i]--,k--;
            }
        }
        
        int oddcount=0;
        for(int i=0; i<26; i++)
        if(ch[i]%2!=0)
        {
            oddcount++;
            if(oddcount>1)
            break;
        }
        
        if(oddcount>1)
        cout<<"NO\n";
        else
        cout<<"YES\n";

    }
}    
