
#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        long long n,f,a,b;
        cin>>n>>f>>a>>b;
        vector<long long>m((n+1),0);
        
        for(long long i=1; i<=n; i++)
        {
            cin>>m[i];
        }
        
        for(long long i=1; i<=n; i++)
       {
           long long s1 = (m[i]-m[i-1])*a;
           long long s2 =1*b;
           
           f-=min(s1,s2);
       }
       
       if(f>0)
       cout<<"YES\n";
       else
       cout<<"NO\n";
       
    //   for (auto u: m) cout<<u<<" ";
    }

    return 0;
}
